# Saraf Instagram Automation V2
# Add these to Railway production variables.
# Keep your real secrets only in Railway; never commit them.

# Existing production variables
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_USER_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_BUSINESS_USERNAME=
INSTAGRAM_GRAPH_API_VERSION=v26.0

# Your current keyword list can stay exactly like this:
INSTAGRAM_COMMENT_KEYWORDS=Saraf,صراف,سراف

# Deterministic keyword flow
INSTAGRAM_KEYWORD_PUBLIC_REPLY=توضیحات به دایرکت شما ارسال شد. سپاس از وقتی که گذاشتید! 💚

# Leave this unset to use V2's built-in professional Saraf intro.
# If you set it, {bot_link} is replaced automatically.
# INSTAGRAM_DM_LINK_MESSAGE=سلام ... {bot_link}

# AI
INSTAGRAM_AI_REPLY_ENABLED=true
INSTAGRAM_DM_AI_ENABLED=true
INSTAGRAM_AI_COMMENT_MAX_CHARS=350
INSTAGRAM_AI_DM_MAX_CHARS=900
INSTAGRAM_DM_HISTORY_LIMIT=8

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=openrouter/free

# Official Saraf bot
TELEGRAM_BOT_LINK=https://t.me/sarafiaf_bot

# Meta webhook fields:
# Make sure the Instagram webhook subscription includes both comments and messages.
INSTAGRAM_SUBSCRIBED_FIELDS=comments,messages
