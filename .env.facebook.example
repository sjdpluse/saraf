# Facebook Page Comment Automation for صراف
# Keep real secrets only in Railway.

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v26.0

FACEBOOK_AI_REPLY_ENABLED=true
FACEBOOK_COMMENT_KEYWORDS=Saraf,صراف,سراف
FACEBOOK_AI_COMMENT_MAX_CHARS=500

# {bot_link} is replaced automatically.
FACEBOOK_KEYWORD_PUBLIC_REPLY=سلام 👋 به صراف خوش آمدید. برای مشاهده نرخ‌های لحظه‌یی ارز، طلا و خدمات صراف، ربات رسمی را باز کنید:\n{bot_link}

# Shared Groq AI variables used by Instagram + Facebook social automation
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# llama-3.3-70b-versatile may be unavailable on some Groq tiers; fallback is tried automatically.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b

TELEGRAM_BOT_LINK=https://t.me/sarafiaf_bot
